# ------------------------------------------------------------
# Environment & Secret Files
# ------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ------------------------------------------------------------
# Python / Flask Backend Ignores
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Linux/Ubuntu & Windows)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# Flask & Application Logs/Storage
backend/logs/*
!backend/logs/.gitkeep
logs/
*.log
backend/backups/*
!backend/backups/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
instance/
.webassets-cache

# Unit Test / Coverage Output
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.pyo
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# Node.js / React Frontend Ignores
# ------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------
# IDE & Code Editor Files
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.pydevproject
.settings/

# ------------------------------------------------------------
# Operating System Temporary & Metadata Files
# ------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

