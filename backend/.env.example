# ============================================================
# Kinder Park Library System - Environment Configuration Example
# Copy this file to '.env' in the backend directory and update values as needed.
# ============================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration (MySQL / MariaDB)
# Compatible with both Linux (Ubuntu) and Windows MySQL installations
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kinder_park_library
DB_PORT=3306
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=20

# JWT Authentication Security Settings
JWT_SECRET_KEY=liugiwquegvbcg;oiwiqeucghhogh2qkedfgd8uigiu22bdfkjcguWGHFCBC;OIUUG;WWEIOFUUG8GOBF;O234HYCWEEC;OIICHH2WE
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Session Settings
SESSION_LIFETIME_HOURS=24
BCRYPT_ROUNDS=12

# Rate Limiting Settings
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Open Library API Settings (External ISBN Metadata Lookup)
OPEN_LIBRARY_API_URL=https://openlibrary.org/api/books
OPEN_LIBRARY_API_TIMEOUT=10
OPEN_LIBRARY_API_RETRIES=3

# Database Backup Settings
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENABLED=True

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Email Server Settings (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@kinderpark.com
